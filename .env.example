ACTIVE_DATA_SOURCE=ZOOM_EARTH

SKIP_INITIAL_TASK=true

# --- PostgreSQL Database Connection ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 瓦片输出到宿主机的路径（Docker 部署时用于映射瓦片目录到宿主机）
# 留空使用命名卷，设置为宿主机路径则使用 bind mount（如：/home/user/aqua-chroma-data）
TILES_HOST_PATH=""

# 判定为有效白天的最小太阳高度角（度），低于此值视为夜间/晨昏，跳过分析。
# 越小窗口越宽（6=接近日出日落，15=较保守），默认 10。
MIN_SUN_ELEVATION_DEG=10