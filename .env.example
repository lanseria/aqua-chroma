ACTIVE_DATA_SOURCE=ZOOM_EARTH

SKIP_INITIAL_TASK=true

# --- PostgreSQL Database Connection ---
DB_HOST=your_db_host_ip
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# 瓦片输出到宿主机的路径（Docker 部署时用于映射瓦片目录到宿主机）
# 留空使用命名卷，设置为宿主机路径则使用 bind mount（如：/home/user/aqua-chroma-data）
TILES_HOST_PATH=""